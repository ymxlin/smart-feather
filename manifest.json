{
  "manifest_version": 2,
  "name": "Smart Feather",
  "description": "__MSG_extensionDescription__",
  "version": "0.3.1",
  "default_locale": "en",
  "icons": {
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "smart-feather@local",
      "strict_min_version": "153.0"
    }
  },
  "permissions": ["compose", "messagesRead", "messagesMove", "messagesDelete", "notifications", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "compose_action": {
    "default_title": "__MSG_aiButton__",
    "default_label": "__MSG_aiButton__",
    "default_icon": "icons/ai.svg"
  },
  "message_display_action": {
    "default_title": "__MSG_summaryButton__",
    "default_label": "__MSG_summaryButton__",
    "default_icon": "icons/ai.svg"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false,
    "browser_style": false
  },
  "experiment_apis": {
    "hoverActions": {
      "schema": "api/hoverActions/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["hoverActions"]],
        "script": "api/hoverActions/implementation.js"
      }
    },
    "composeDoc": {
      "schema": "api/composeDoc/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["composeDoc"]],
        "script": "api/composeDoc/implementation.js"
      }
    },
    "aiHelp": {
      "schema": "api/aiHelp/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["aiHelp"]],
        "script": "api/aiHelp/implementation.js"
      }
    }
  }
}
