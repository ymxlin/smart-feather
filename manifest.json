{
  "manifest_version": 2,
  "name": "Smart Feather",
  "description": "__MSG_extensionDescription__",
  "version": "0.2.3",
  "default_locale": "en",
  "icons": {
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "smart-feather@local",
      "strict_min_version": "153.0"
    }
  },
  "permissions": ["compose", "messagesRead", "messagesMove", "messagesDelete", "notifications"],
  "background": {
    "scripts": ["background.js"]
  },
  "experiment_apis": {
    "hoverActions": {
      "schema": "api/hoverActions/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["hoverActions"]],
        "script": "api/hoverActions/implementation.js"
      }
    },
    "composeDoc": {
      "schema": "api/composeDoc/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["composeDoc"]],
        "script": "api/composeDoc/implementation.js"
      }
    }
  }
}
